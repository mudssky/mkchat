    "prisma:studio-prod": "dotenv -e .env.production prisma studio --port 5655",
    "typecheck": "tsc --noEmit",
    "typecheck:fast": "tsgo --noEmit",
    "qa": "pnpm typecheck:fast && pnpm format:check && pnpm test:run",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "setup:rules": "rule-loader  convert -t antigravity",
    "prepare": "husky"
  },
